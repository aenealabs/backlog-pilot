# LLM provider: "replay" (offline demo, no key needed) or "anthropic" (live)
BP_LLM_PROVIDER=replay
# Credentials for live mode: pick ONE. Leave the others unset; an ANTHROPIC_API_KEY line,
# even an empty one, takes precedence over federation.
# ANTHROPIC_API_KEY=sk-ant-...
# Workload identity federation (no long-lived key):
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_IDENTITY_TOKEN_FILE=
BP_MODEL=claude-opus-5-5
# Record live responses into data/replays so they can be replayed offline in demos
BP_RECORD=false
# SQLite file for the mock tracker
BP_DB_PATH=backlog_pilot.db

# ---------- Enterprise deployment (M4) ----------
# Claude on Microsoft Foundry: BP_LLM_PROVIDER=foundry, BP_MODEL=<deployment name>
# ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
# ANTHROPIC_FOUNDRY_API_KEY=            # omit to sign in with Entra ID (pip install '.[azure]')

# Push approved items to a tracker: mock (default) | jira | ado
BP_TRACKER=mock
# BP_JIRA_URL=https://your-company.atlassian.net
# BP_JIRA_PROJECT=PLM
# BP_JIRA_EMAIL=you@company.com         # Jira Cloud (with an API token); omit for Data Center PAT
# BP_JIRA_TOKEN=
# BP_JIRA_TYPES=epic=Epic,feature=Feature,story=Story
# BP_JIRA_EPIC_LINK_FIELD=customfield_10014   # only for Data Center without parent links
# BP_ADO_ORG_URL=https://dev.azure.com/your-org
# BP_ADO_PROJECT=Engineering
# BP_ADO_TOKEN=                         # personal access token with Work Items (read & write)
# BP_ADO_TYPES=story=Product Backlog Item     # for the Scrum process

# Sign-in: demo (default, "acting as" picker) | oidc (Microsoft Entra ID or any OIDC provider)
BP_AUTH=demo
# BP_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# BP_OIDC_CLIENT_ID=
# BP_OIDC_CLIENT_SECRET=
# BP_SESSION_SECRET=                    # long random string
# BP_APPROVER_ROLE=BacklogPilot.Approver
# BP_APPROVER_EMAILS=                   # optional comma-separated allow-list

# ---------- Mission Control suite (Backlog Pilot + Leadership Pilot) ----------
# Shared secret for the suite API that Leadership Pilot calls; empty switches the API off.
# BP_SUITE_TOKEN=
# Where Leadership Pilot runs, for the app switcher and links.
# BP_LEADERSHIP_URL=http://127.0.0.1:8010

# Mission Control launcher: the same value in every suite app. The app name in the app bar
# opens a menu of these apps. Adding an app = adding it here, in each app's settings.
# MISSION_CONTROL_APPS=Backlog Pilot=http://127.0.0.1:8000, Leadership Pilot=http://127.0.0.1:8010, PLM Insight=http://127.0.0.1:8020
